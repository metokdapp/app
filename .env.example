# METOK V4 — Monad Mainnet
VITE_METOK_CONTRACT=0xE25AaBa9CBCD0DF6e0b3659c66F1C022a4ED1cf6

# Comma-separated PUBLIC HTTPS RPC endpoints. The DApp uses viem ranked fallback
# and independently probes chainId/block/latency. Add 2+ independent providers in production.
# Never put API secrets that you consider private in VITE_*; Vite embeds them into the browser bundle.
VITE_RPC_URLS=https://rpc.monad.xyz
VITE_EXPLORER_URL=https://monadscan.com

# Optional optimization. Leave blank to auto-locate the deployment block from DEPLOYED_AT.
# Once you know the exact deployment block, setting it avoids the one-time binary search.
VITE_DEPLOYMENT_BLOCK=

# MetaMask Connect 5.1 uses the configured Monad RPC for chain 0x8f.
# No WalletConnect project ID is required. MetaMask Connect analytics are disabled in source.
